<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#0b0c10" android:fillViewport="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="28dp" android:gravity="center_horizontal">
  <ImageView android:layout_width="84dp" android:layout_height="84dp" android:src="@mipmap/ic_launcher" android:layout_marginTop="40dp"/>
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Kumanda" android:textColor="#ffffff" android:textSize="26sp" android:textStyle="bold" android:layout_marginTop="14dp"/>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Bilgisayardaki Kumanda uygulamasına bağlan. Bilgisayarda Telefon penceresini aç, QR kodu okut; bir kez yeter, sonra hep bağlı kalır." android:textColor="#9aa3b2" android:textSize="14sp" android:gravity="center" android:layout_marginTop="10dp" android:lineSpacingExtra="3dp"/>
  <Button android:id="@+id/scan" android:layout_width="match_parent" android:layout_height="52dp" android:text="QR kodu okut" android:textAllCaps="false" android:textSize="16sp" android:layout_marginTop="28dp" android:backgroundTint="#e08a5b" android:textColor="#111111"/>
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ya da adresi yapıştır" android:textColor="#6b7483" android:textSize="12sp" android:layout_marginTop="22dp"/>
  <EditText android:id="@+id/url" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="http://192.168.1.20:20127/#anahtar" android:textColorHint="#55607050" android:textColor="#ffffff" android:inputType="textUri" android:imeOptions="actionGo" android:layout_marginTop="6dp" android:backgroundTint="#2c3038" android:textSize="14sp"/>
  <Button android:id="@+id/go" android:layout_width="match_parent" android:layout_height="48dp" android:text="Bağlan" android:textAllCaps="false" android:layout_marginTop="10dp" android:backgroundTint="#23262e" android:textColor="#ffffff"/>
  <TextView android:id="@+id/err" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#e06c6c" android:textSize="13sp" android:gravity="center" android:layout_marginTop="12dp"/>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Bu uygulama yalnızca bir penceredir: her şey bilgisayarındaki Kumanda'dan gelir. Bilgisayardaki güncellemeler telefona kendiliğinden yansır." android:textColor="#55607a" android:textSize="12sp" android:gravity="center" android:layout_marginTop="34dp" android:lineSpacingExtra="2dp"/>
</LinearLayout></ScrollView>
